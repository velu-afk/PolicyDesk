# Application Settings
APP_NAME="PolicyDesk RAG Document Assistant"
APP_ENV="development"
DEBUG=false
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://policydesk.vercel.app"

# Database Configuration (Neon PostgreSQL in production; SQLite supported for local dev/testing)
# Example Neon URL: postgresql+psycopg2://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/policydesk?sslmode=require
DATABASE_URL="postgresql+psycopg2://neondb_owner:replace_with_password@ep-example-pooler.us-east-2.aws.neon.tech/policydesk?sslmode=require"

# JWT & Security Settings
JWT_SECRET_KEY="replace_with_64_byte_cryptographically_random_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_HASH_SCHEME="argon2"

# Initial Admin Seed Credentials (Used by python -m app.seed)
INITIAL_ADMIN_NAME="PolicyDesk System Admin"
INITIAL_ADMIN_EMAIL="admin@policydesk.io"
INITIAL_ADMIN_PASSWORD="ChangeMe_Admin_2026!"

# Optional Demo Normal User Seed Credentials
INITIAL_USER_NAME="Alex Rivera"
INITIAL_USER_EMAIL="user@policydesk.io"
INITIAL_USER_PASSWORD="ChangeMe_User_2026!"

# Google Gemini AI Configuration
GEMINI_API_KEY="replace_with_your_google_ai_studio_gemini_api_key"
GEMINI_LLM_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TEMPERATURE=0.1

# RAG & Document Processing Configuration
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
